   "name": "Compose Alert",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    224,
    0
   ],
   "parameters": {
    "jsCode": "// What broke, where, and a link to the failed run — short enough for WhatsApp.\nconst j = $input.first().json || {};\nconst ex = j.execution || {};\nconst wf = j.workflow || {};\nconst err = ex.error || j.trigger?.error || {};\nconst node = ex.lastNodeExecuted || err.node?.name || 'unknown step';\nconst msg = String(err.message || err.description || 'Unknown error').slice(0, 400);\nconst text = [\n  '🚨 *WhatsApp bot error*',\n  `Workflow: ${wf.name || wf.id || 'unknown'}`,\n  `Step: ${node}`,\n  `Error: ${msg}`,\n  ex.url ? `Run: ${ex.url}` : null,\n  '',\n  '_Customers may not be getting replies until this is fixed._',\n].filter((l) => l !== null).join('\\n');\nreturn [{ json: { text } }];"
   }
  },
  {
   "id": "0cd6416a-4138-4a76-bc6c-f256ea5248fd",
   "name": "WhatsApp the Owner",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.3,
   "position": [
    448,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $json.evolution_url }}/message/sendText/{{ $json.alert_instance }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\n  \"number\": \"{{ $json.owner_number }}\",\n  \"text\": {{ JSON.stringify($('Compose Alert').first().json.text) }},\n  \"linkPreview\": false\n}",
    "options": {}
   },
   "credentials": {
    "httpHeaderAuth": {
     "name": "Header Auth account"
    }
   }
  },
