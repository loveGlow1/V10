  {
   "id": "73db8508-7eaf-4f75-96ba-c0fe2cfc7653",
   "name": "Get Businesses",
   "type": "n8n-nodes-base.supabase",
   "typeVersion": 1,
   "position": [
    1344,
    80
   ],
   "parameters": {
    "authentication": "oAuth2",
    "resource": "row",
    "operation": "getAll",
    "projectRef": "={{ $('Work Out Settings').first().json.supabase_project_ref }}",
    "tableId": "clients",
    "returnAll": true
   },
