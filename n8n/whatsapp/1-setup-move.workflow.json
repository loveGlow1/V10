     "name": "Supabase account"
    }
   }
  },
  {
   "id": "a72a8a1d-3c79-4b70-9be2-386f83e6c97f",
   "name": "Businesses To Repoint",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1568,
    80
   ],
   "parameters": {
    "jsCode": "// Every business with a WhatsApp instance, unless repointing was switched off.\n// Always returns at least one item so the report page is shown.\nconst s = $('Work Out Settings').first().json;\nconst list = s.repoint ? $input.all().map((i) => i.json).filter((c) => c && c.instance_name).map((c) => ({ json: { instance: c.instance_name, business: c.business_name || c.client_id } })) : [];\nreturn list.length ? list : [{ json: { none: true } }];"
   }
  },
  {
   "id": "018533a1-bda4-4d10-9f33-5929d491d36f",
   "name": "Anything To Repoint?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1792,
    80
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "leftValue": "={{ $json.none !== true }}",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    }
   }
  },
  {
   "id": "c2a0bdb3-66d5-4e1b-9798-714ecc23857c",
   "name": "Point WhatsApp Here",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.3,
   "position": [
    2016,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $('Work Out Settings').first().json.evolution_url }}/webhook/set/{{ $json.instance }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ webhook: { enabled: true, url: $('Work Out Settings').first().json.engine_webhook_url, byEvents: false, base64: false, events: ['MESSAGES_UPSERT'] } }) }}",
    "options": {
     "timeout": 20000
    }
   },
   "onError": "continueRegularOutput",
   "credentials": {
    "httpHeaderAuth": {
     "name": "Header Auth account"
    }
   }
  },
  {
   "id": "6104fc26-824d-413a-8ae9-aad3b6fb6516",
   "name": "Build Report",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2240,
    80
   ],
   "parameters": {
    "jsCode": "// One line per business: did its WhatsApp get pointed at this n8n?\nconst s = $('Work Out Settings').first().json;\nlet rows = [];\ntry {\n  const sent = $('Point WhatsApp Here').all();\n  const asked = $('Businesses To Repoint').all();\n  rows = sent.map((r, i) => {\n    const b = asked[i].json;\n    const ok = !r.json.error && !(Number(r.json.status) >= 400);\n    return { business: b.business, instance: b.instance, ok, why: ok ? '' : String((r.json.error && (r.json.error.message || r.json.error)) || r.json.message || 'failed').slice(0, 160) };\n  });\n} catch (e) { rows = []; }\nconst esc = (t) => String(t).replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]));\nconst table = rows.length\n  ? '<table style=\"width:100%;border-collapse:collapse;text-align:left\">' + rows.map((r) => '<tr><td style=\"padding:4px;border-bottom:1px solid #eee\">' + (r.ok ? '✅' : '❌') + ' ' + esc(r.business) + '</td><td style=\"padding:4px;border-bottom:1px solid #eee;color:#666\">' + esc(r.instance) + (r.ok ? '' : ' — ' + esc(r.why)) + '</td></tr>').join('') + '</table>'\n  : '<p style=\"color:#666\">' + (s.repoint ? 'No businesses found in Supabase (or Supabase could not be reached — check the Supabase credential and project ref).' : 'Repointing was switched off.') + '</p>';\nconst failed = rows.filter((r) => !r.ok).length;\nreturn [{ json: { html: '<div style=\"font-family:system-ui,sans-serif;max-width:560px;margin:24px auto\">'\n  + '<h2>✅ Settings saved</h2>'\n  + '<p>Evolution: <code>' + esc(s.evolution_url) + '</code><br/>Supabase project: <code>' + esc(s.supabase_project_ref) + '</code><br/>Engine webhook: <code>' + esc(s.engine_webhook_url) + '</code><br/>Error alerts to: <code>' + esc(s.owner_number) + '</code> via <code>' + esc(s.alert_instance) + '</code></p>'\n  + '<h3>WhatsApp numbers pointed here' + (rows.length ? ' (' + (rows.length - failed) + ' of ' + rows.length + ')' : '') + '</h3>' + table\n  + (failed ? '<p style=\"color:#b45309\">Failed ones: check the Header Auth credential (Name <b>apikey</b>, Value = Evolution global key) and that the instance exists, then submit this form again.</p>' : '')\n  + '<h3>Last checks</h3><ol><li>Publish the 4 WhatsApp Bot workflows (Engine, Add a Business, Daily Summary, Error Alerts).</li><li>In the Engine and Daily Summary: Workflow settings → Error workflow → <b>WhatsApp Bot — Error Alerts</b>.</li><li>Send “hi” to any business number.</li></ol></div>' } }];"
   },
   "executeOnce": true
  },
