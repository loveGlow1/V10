  {
   "id": "a3dff2b9-7771-4a12-9619-5360174bf6dc",
   "name": "Work Out Settings",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    672,
    80
   ],
   "parameters": {
    "jsCode": "// The values every WhatsApp workflow reads from wa_settings. The engine's\n// address is this n8n's own address unless one is typed in.\nconst f = $('Setup / Move').first().json;\nconst clean = (u) => { u = String(u || '').trim().replace(/\\/+$/, ''); return u && !/^https?:\\/\\//.test(u) ? 'https://' + u : u; };\nconst base = String($execution.resumeUrl || '').split('/webhook-waiting')[0];\nreturn [{ json: {\n  evolution_url: clean(f.evolution_url),\n  supabase_project_ref: String(f.supabase_project_ref || '').trim().replace(/^https?:\\/\\//, '').replace(/\\.supabase\\.co.*$/, ''),\n  engine_webhook_url: clean(f.engine_webhook_url) || base + '/webhook/faa757c3-e220-420d-bd89-803d5393f58e',\n  owner_number: String(f.owner_number || '').replace(/\\D/g, '').replace(/^0(\\d{10})$/, '234$1'),\n  alert_instance: String(f.alert_instance || '').trim(),\n  repoint: f.repoint !== 'No',\n} }];"
   }
  },
  {
   "id": "12460b39-9ac4-4cfb-ab84-dd7e2d2ddc37",
